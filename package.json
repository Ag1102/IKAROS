{
  "name": "ikaros",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run && npm run test -w @ikaros/web",
    "typecheck": "tsc -b",
    "telemetry": "tsx packages/sim/src/cli.ts",
    "format": "prettier --write packages tests vitest.config.ts",
    "format:check": "prettier --check packages tests vitest.config.ts",
    "atlas:voz": "powershell -ExecutionPolicy Bypass -File scripts/atlas-voz.ps1"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "prettier": "3.3.3",
    "tsx": "4.20.3",
    "typescript": "5.6.3",
    "vitest": "3.2.4"
  }
}
