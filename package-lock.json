{
  "name": "ikaros",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "ikaros",
      "version": "0.0.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "devDependencies": {
        "typescript": "5.6.3"
      }
    },
    "apps/web": {
      "name": "@ikaros/web",
      "version": "0.0.0",
      "dependencies": {
        "@ikaros/contracts": "*",
        "@ikaros/sim-mock": "*"
      }
    },
    "node_modules/@ikaros/contracts": {
      "resolved": "packages/contracts",
      "link": true
    },
    "node_modules/@ikaros/sim": {
      "resolved": "packages/sim",
      "link": true
    },
    "node_modules/@ikaros/sim-mock": {
      "resolved": "packages/sim-mock",
      "link": true
    },
    "node_modules/@ikaros/web": {
      "resolved": "apps/web",
      "link": true
    },
    "node_modules/typescript": {
      "version": "5.6.3",
      "resolved": "https://registry.npmjs.org/typescript/-/typescript-5.6.3.tgz",
      "integrity": "sha512-hjcS1mhfuyi4WW8IWtjP7brDrG2cuDZukyrYrSauoXGNgx0S7zceP07adYkJycEr56BOUTNPzbInooiN3fn1qw==",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "packages/contracts": {
      "name": "@ikaros/contracts",
      "version": "0.0.0"
    },
    "packages/sim": {
      "name": "@ikaros/sim",
      "version": "0.0.0",
      "dependencies": {
        "@ikaros/contracts": "*"
      }
    },
    "packages/sim-mock": {
      "name": "@ikaros/sim-mock",
      "version": "0.0.0",
      "dependencies": {
        "@ikaros/contracts": "*"
      }
    }
  }
}
